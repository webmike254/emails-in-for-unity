# Copy this file to .env and fill in real values (local testing only).
# On Vercel, set these as project Environment Variables instead.

# Mailjet (send + inbound)
MAILJET_API_KEY=
MAILJET_SECRET_KEY=

# Default sender on the verified domain
SENDER_DEFAULT=hr@unity-software.online
SENDER_NAME_DEFAULT=Unity Software

# Inbound: forward received mail to this inbox
INBOUND_FORWARD_TO=

# Secret used to protect /api/r2-setup and /api/inbound debug endpoints
SETUP_SECRET=

# Base URL for images used inside sent emails (header.jpg, avatars).
# Currently hosted by Vercel itself:
# ASSET_BASE_URL=https://emails-in-for-unitys.vercel.app
# After enabling R2 in the Cloudflare dashboard, run /api/r2-setup and use the
# returned assetBase value here instead.
ASSET_BASE_URL=

# Cloudflare R2 (used by tools/upload-assets.mjs and /api/r2-setup)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=unity-email-assets